APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql://dealos_app:devpass@postgres:5432/dealos
REDIS_URL=redis://redis:6379/0

# OIDC: Microsoft Entra, Okta, Auth0, etc.
OIDC_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_ALLOWED_INTERNAL_DOMAIN=xnergy.com
DEV_AUTH_BYPASS=true
DEV_AUTH_EMAIL=admin@xnergy.local

SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
COOKIE_DOMAIN=
CSRF_HEADER_NAME=X-CSRF-Token

# Azure Blob / object storage
AZURE_STORAGE_ACCOUNT_URL=https://YOURACCOUNT.blob.core.windows.net
AZURE_STORAGE_CONNECTION_STRING=
AZURE_QUARANTINE_CONTAINER=dealos-quarantine
AZURE_CLEAN_CONTAINER=dealos-clean
MAX_UPLOAD_BYTES=104857600
MALWARE_SCAN_REQUIRED=true

# Defender for Storage -> Event Grid -> Service Bus queue
AZURE_SERVICEBUS_FQDN=YOURNS.servicebus.windows.net
AZURE_SERVICEBUS_CONNECTION_STRING=
MALWARE_SCAN_QUEUE=dealos-malware-results

# Optional app-level encryption for selected metadata values.
KEY_VAULT_URL=https://YOURVAULT.vault.azure.net/
